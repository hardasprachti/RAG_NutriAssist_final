# Copy to .env (backend) and fill in. Never commit .env.

# ── LLM ─────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

# ── Embeddings (local, sentence-transformers) ───────
# EMBEDDING_DIM must match the Qdrant collection vector size.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ── Vector Database ──────────────────────────────────
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=nutrition_chunks

# ── Relational Database ──────────────────────────────
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Tests only (optional) ────────────────────────────
# Point at THROWAWAY local servers (never Supabase/production): the Postgres tests create
# and drop their own temporary databases. Without these, tests use SQLite + in-memory Qdrant.
TEST_DATABASE_URL=
TEST_QDRANT_URL=

# ── Backend ──────────────────────────────────────────
BACKEND_SECRET_KEY=
# Comma-separated list of allowed browser origins. Falls back to http://localhost:3000 if blank.
ALLOWED_ORIGINS=
LOG_LEVEL=INFO
# Load the embedding model at startup instead of on the first request (recommended in production).
PRELOAD_MODELS=true
# Optional LLM second pass for the safety validator (rules always run first and always win).
SAFETY_LLM_CLASSIFIER=false

# ── RAG pipeline ─────────────────────────────────────────────────────────────
# Chunks retrieved per question.
RETRIEVAL_TOP_K=5
# Cosine-similarity gate: below this the corpus is treated as not covering the question and no LLM call is
# made (not_in_corpus). Measured on bge-small: unrelated questions score <=0.53, in-corpus questions >=0.69.
# Coarse by design; the LLM-side not_in_corpus status handles nutrition-adjacent questions. Tune in Phase 7/8.
RETRIEVAL_MIN_SCORE=0.58
# Previous user/assistant pairs shown to the model as context.
HISTORY_TURNS=3
# Extra generation attempts after a response fails validation (error status afterwards).
MAX_VALIDATION_RETRIES=1

# ── API limits (Phase 5) ─────────────────────────────────────────────────────
# Requests per minute per client IP; 0 disables. Chat is the expensive one (an LLM call each).
# The counters live in process memory: run one backend instance, or enforce limits at the proxy too.
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=120
# Wall-clock limit for one /api/chat request (retrieval + generation + one validation retry), then 504.
CHAT_TIMEOUT_SECONDS=90
# Chat pipelines running at once; others wait (counts toward the timeout). Protects a small instance.
CHAT_MAX_CONCURRENCY=4

# ── Frontend (public, safe to expose) ────────────────
# Set in frontend/.env.local for local dev, and in Vercel for production.
NEXT_PUBLIC_API_URL=
